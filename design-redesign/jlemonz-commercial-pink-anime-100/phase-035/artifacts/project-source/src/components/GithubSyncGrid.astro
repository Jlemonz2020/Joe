---
import { githubSyncRules } from "../data/githubSyncRules";

const skeletonCells = Array.from({ length: 98 });
const syncRulesCount = githubSyncRules.length;
---

<section class="diary-card diary-card--glass github-sync" data-github-sync data-endpoint="/api/github/contributions" data-rules-count={syncRulesCount} aria-labelledby="github-sync-title">
  <div class="github-sync__header">
    <div>
      <p class="github-sync__eyebrow">SYNC FREQUENCY</p>
      <h2 id="github-sync-title">GitHub 同步手帐格</h2>
      <p>从贡献数据里取最近一段节奏，像贴纸格一样留在首页。</p>
    </div>
    <div class="github-sync__stamp" aria-live="polite" data-github-status>同步中</div>
  </div>

  <div class="github-sync__meta" aria-label="GitHub 同步概览">
    <span><strong data-github-user>Jlemonz2020</strong><small>账号</small></span>
    <span><strong data-github-total>--</strong><small>年度同步</small></span>
    <span><strong data-github-range>最近 98 天</strong><small>显示范围</small></span>
  </div>

  <div class="github-sync__grid-wrap">
    <div class="github-sync__grid" data-github-grid aria-label="GitHub 最近同步频率">
      {skeletonCells.map(() => <span class="github-sync__cell github-sync__cell--loading" aria-hidden="true"></span>)}
    </div>
    <aside class="github-sync__memo" aria-label="GitHub 同步便签">
      <span>同步便签</span>
      <strong data-github-note>等待 GitHub 数据贴到手帐里。</strong>
    </aside>
  </div>

  <div class="github-sync__legend" aria-label="同步强度图例">
    <span>轻</span>
    <i data-level="0"></i>
    <i data-level="1"></i>
    <i data-level="2"></i>
    <i data-level="3"></i>
    <i data-level="4"></i>
    <span>满</span>
  </div>

  <p class="github-sync__fallback" data-github-fallback hidden>同步格暂时没取到数据，稍后再让赛蕾翻一次记录。</p>
</section>

<script is:inline>
  (() => {
    const clampLevel = (value) => {
      const level = Number(value);
      if (!Number.isFinite(level)) return 0;
      return Math.max(0, Math.min(4, Math.round(level)));
    };

    const formatDate = (date) => {
      if (!date) return "未知日期";
      return String(date);
    };

    const recentDays = (days) => Array.isArray(days) ? days.slice(-98) : [];

    const renderFallback = (root) => {
      root.dataset.githubState = "fallback";
      root.querySelector("[data-github-status]").textContent = "稍后重试";
      root.querySelector("[data-github-total]").textContent = "--";
      root.querySelector("[data-github-note]").textContent = "接口暂时没回应，先保留 49 枚淡粉贴纸格等下次同步。";
      root.querySelector("[data-github-fallback]").hidden = false;
      const grid = root.querySelector("[data-github-grid]");
      grid.innerHTML = "";
      for (let index = 0; index < 49; index += 1) {
        const cell = document.createElement("span");
        cell.className = "github-sync__cell github-sync__cell--muted";
        cell.setAttribute("aria-hidden", "true");
        grid.append(cell);
      }
    };

    const renderGithubGrid = (root, payload) => {
      const days = recentDays(payload?.days);
      if (!days.length) {
        renderFallback(root);
        return;
      }

      root.dataset.githubState = "ready";
      root.querySelector("[data-github-status]").textContent = "已同步";
      root.querySelector("[data-github-user]").textContent = payload.username || "Jlemonz2020";
      root.querySelector("[data-github-total]").textContent = String(payload.total ?? 0);
      root.querySelector("[data-github-range]").textContent = `${days.length} 天`;
      root.querySelector("[data-github-note]").textContent = `最近 ${days.length} 天里，有 ${days.reduce((sum, day) => sum + Number(day.count || 0), 0)} 次同步被贴进手帐格。`;
      root.querySelector("[data-github-fallback]").hidden = true;

      const grid = root.querySelector("[data-github-grid]");
      grid.innerHTML = "";

      for (const day of days) {
        const level = clampLevel(day.level);
        const count = Number(day.count || 0);
        const cell = document.createElement("span");
        cell.className = "github-sync__cell";
        cell.dataset.level = String(level);
        cell.dataset.count = String(count);
        cell.title = `${formatDate(day.date)} / ${count} 次同步`;
        cell.setAttribute("aria-label", `${formatDate(day.date)}，${count} 次同步`);
        grid.append(cell);
      }
    };

    const hydrateGithubSync = async (root) => {
      root.dataset.githubState = "loading";
      try {
        const response = await fetch(root.dataset.endpoint || "/api/github/contributions", {
          headers: { accept: "application/json" }
        });
        if (!response.ok) {
          renderFallback(root);
          return;
        }
        renderGithubGrid(root, await response.json());
      } catch {
        renderFallback(root);
      }
    };

    document.querySelectorAll("[data-github-sync]").forEach((root) => {
      hydrateGithubSync(root);
    });
  })();
</script>
