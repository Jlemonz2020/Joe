---
import { pages, type PageKey } from "../data/pageMeta";

interface Props {
  active: PageKey;
}

const { active } = Astro.props;
---

<header class="site-header">
  <a class="brand" href="/index.html" translate="no" aria-label="Jlemonz 首页">
    <span class="brand-mark">J</span>
    <span>
      <strong>Jlemonz</strong>
      <small>Pink Diary</small>
    </span>
  </a>
  <nav class="nav-links" aria-label="主导航">
    {Object.entries(pages).map(([key, page]) => (
      <a class:list={["nav-link", { active: key === active }]} href={page.href}>
        {page.nav}
      </a>
    ))}
  </nav>
  <div class="header-actions" aria-label="快捷入口">
    <button type="button" aria-label="打开搜索">⌕</button>
    <button type="button" aria-label="切换主题">✿</button>
  </div>
</header>
