NODE_ENV=development
HOST=127.0.0.1
PORT=8097

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=joe_blog
DB_USER=joe_blog

# Redis is used for response caching. The app still serves a fallback when it is unavailable.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional search service.
MEILI_HOST=http://127.0.0.1:7700

UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_PATH=/uploads

# Public profile integration.
GITHUB_USERNAME=Jlemonz

# Optional AI/provider settings.
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Secrets and private credentials live in config/keys.env.
# Copy config/keys.example.env to config/keys.env and fill it locally or on the server.
